{
  "name": "bayocard-mobile",
  "type": "commonjs",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "build:android": "eas build -p android --profile production",
    "build:android:preview": "eas build -p android --profile preview",
    "reset-project": "node ./scripts/reset-project.js",
    "start:dev-client": "expo start --dev-client",
    "build:dev:android": "eas build -p android --profile development",
    "build:dev:ios": "eas build -p ios --profile development",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/tajawal": "^0.4.1",
    "@expo/app-integrity": "^57.0.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/upng-js": "^2.1.5",
    "axios": "^1.13.5",
    "buffer": "^6.0.3",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bluetooth-classic": "1.73.0-rc.17",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "string_decoder": "^1.3.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "babel-preset-expo": "~57.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.0",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "overrides": {
    "react-native": "$react-native",
    "react": "$react",
    "uuid": "^11.1.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket",
          "react-native-bluetooth-classic"
        ]
      }
    }
  }
}
